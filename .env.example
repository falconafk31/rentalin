# HeavyOps — contoh variabel lingkungan (salin ke .env.local lalu isi nilai asli)
# Jangan commit .env.local — hanya .env.example yang dilacak git.
DATABASE_URL="postgresql://postgres.<ref>:<kata-sandi>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require"
NEXT_PUBLIC_SUPABASE_URL="https://<ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="isi-publishable-key-supabase"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
